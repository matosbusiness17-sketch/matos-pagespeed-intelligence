# ==========================================
# Matos PageSpeed Intelligence Configuration
# ==========================================

# Google PageSpeed Insights API Key (Required for live scans)
# Obtain from Google Cloud Console with PageSpeed Insights API v5 enabled.
PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# Internal Bearer Token for automation endpoints (e.g., n8n workflows)
# Keep this secret; used to authenticate /api/v1/* requests.
MATOS_INTERNAL_API_TOKEN=matos_sec_token_example_change_in_production

# Local SQLite Database file path (defaults to ./data/pagespeed.db if unset)
DATABASE_PATH=./data/pagespeed.db

# Application Environment
NODE_ENV=development
